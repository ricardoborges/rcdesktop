export struct ContainerItem {
    id: string,
    name: string,
    image: string,
    status: string,
    state: string,
    ports: string,
    stack: string,
    // In-flight lifecycle label ("Starting…", "Stopping…"); empty when idle
    pending: string,
}

// Containers sharing a compose project, shown as a collapsible group.
export struct StackItem {
    name: string,
    running: int,
    total: int,
    collapsed: bool,
    pending: string,
    containers: [ContainerItem],
}

export struct ImageItem {
    id: string,
    repository: string,
    tag: string,
    size: string,
    created: string,
}

export struct VolumeItem {
    name: string,
    driver: string,
    scope: string,
}

export struct SessionInfoItem {
    session_id: string,
    is_elevated: bool,
    is_healthy: bool,
    status_message: string,
    version: string,
}
