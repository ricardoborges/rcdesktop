import { Theme } from "../theme.slint";
import { Icon } from "button.slint";

export component Card inherits Rectangle {
    vertical-stretch: 0;
    background: Theme.card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-light;
    clip: true;
}

// Page title + subtitle on the left, action buttons (children) on the right.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;

    spacing: Theme.spacing-md;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.title;
            font-size: Theme.font-title;
            font-weight: 600;
            color: Theme.text-main;
            overflow: elide;
        }

        Text {
            text: root.subtitle;
            font-size: Theme.font-body;
            color: Theme.text-dim;
            overflow: elide;
        }
    }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            spacing: Theme.spacing-sm;
            @children
        }
    }
}

export component EmptyState inherits Card {
    in property <string> icon;
    in property <string> title;
    in property <string> message;

    height: 200px;

    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing-sm;

        Icon {
            text: root.icon;
            font-size: 32px;
            color: Theme.text-dim;
        }

        Text {
            text: root.title;
            font-size: Theme.font-subtitle;
            font-weight: 600;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }

        Text {
            text: root.message;
            font-size: Theme.font-body;
            color: Theme.text-dim;
            horizontal-alignment: center;
        }
    }
}

// Uppercase column caption used in table headers.
export component ColumnHeader inherits Text {
    font-size: Theme.font-caption;
    font-weight: 600;
    color: Theme.text-dim;
    vertical-alignment: center;
    overflow: elide;
}

// Table header strip; shares TableRow paddings so columns line up.
export component TableHeader inherits HorizontalLayout {
    height: 40px;
    padding-left: Theme.spacing-md;
    padding-right: Theme.spacing-sm;
    spacing: Theme.spacing-md;
}

// Horizontal hairline separating table rows.
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// Table row shell: fixed height, hover highlight, children laid out horizontally.
export component TableRow inherits Rectangle {
    height: Theme.row-height;
    background: hover.has-hover ? Theme.row-hover : transparent;

    hover := TouchArea {}

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-sm;
        spacing: Theme.spacing-md;
        @children
    }
}

// Title + muted secondary line, vertically centered. Stretches horizontally.
export component TwoLineCell inherits VerticalLayout {
    in property <string> primary;
    in property <string> secondary;

    alignment: center;
    spacing: 2px;
    horizontal-stretch: 1;
    min-width: 100px;

    Text {
        text: root.primary;
        font-size: Theme.font-body;
        font-weight: 600;
        color: Theme.text-main;
        overflow: elide;
    }

    Text {
        text: root.secondary;
        font-size: Theme.font-caption;
        color: Theme.text-dim;
        overflow: elide;
    }
}

// Single-line text cell, vertically centered.
export component TextCell inherits Text {
    font-size: Theme.font-body;
    color: Theme.text-muted;
    vertical-alignment: center;
    overflow: elide;
}
