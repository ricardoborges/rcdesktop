import { Theme, Icons } from "../theme.slint";
import { Icon } from "button.slint";

export component StatusBar inherits Rectangle {
    in property <string> session-name: "wslc-default";
    in property <string> version: "5.0.1.1";
    in property <bool> is-healthy: true;
    in property <bool> is-elevated: false;
    in property <string> message: "Connected";

    height: 30px;
    background: Theme.sidebar-background;

    // Top border line
    Rectangle {
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.border-light;
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;

        // Health indicator + message (left, takes remaining space)
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing-sm;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.is-healthy ? Theme.status-running : Theme.status-danger;
                }
            }

            Text {
                text: root.message;
                color: Theme.text-muted;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // Elevation warning
        if root.is-elevated : HorizontalLayout {
            spacing: 6px;

            Icon {
                text: Icons.warning;
                font-size: 12px;
                color: Theme.status-starting;
            }

            Text {
                text: "Running as Administrator";
                color: Theme.status-starting;
                font-size: Theme.font-caption;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // Session & version (right)
        Text {
            text: "Session " + root.session-name + "  ·  wslc v" + root.version;
            color: Theme.text-dim;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }
}
