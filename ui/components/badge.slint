import { Theme } from "../theme.slint";

// Pill-shaped status indicator. Sizes itself to its text and stays
// vertically centered when placed in a taller layout cell.
export component StatusBadge inherits HorizontalLayout {
    in property <string> text: "Running";
    in property <string> state: "Running"; // Running, Exited, Created, Starting, Warning, Danger

    property <color> fg: state == "Running" ? Theme.status-running :
                         state == "Starting" || state == "Warning" ? Theme.status-starting :
                         state == "Danger" ? Theme.status-danger :
                         Theme.status-exited;
    property <color> bg: state == "Running" ? Theme.status-running-bg :
                         state == "Starting" || state == "Warning" ? Theme.status-starting-bg :
                         state == "Danger" ? Theme.status-danger-bg :
                         Theme.status-exited-bg;

    alignment: start;

    VerticalLayout {
        alignment: center;

        Rectangle {
            height: 22px;
            border-radius: 11px;
            background: root.bg;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.fg;
                    }
                }

                Text {
                    text: root.text;
                    color: root.fg;
                    font-size: Theme.font-caption;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}
