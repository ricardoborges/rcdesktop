import { Theme, Icons } from "../theme.slint";
import { Icon } from "button.slint";

export component NavItem inherits Rectangle {
    in property <string> text: "Item";
    in property <string> icon: "";
    in property <bool> active: false;
    in property <int> badge-count: -1;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.surface-active :
                touch.has-hover ? #ffffff0a :
                transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Windows 11 style active indicator pill
    if root.active : Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.primary;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;

        Icon {
            width: 18px;
            text: root.icon;
            font-size: 16px;
            color: root.active ? Theme.primary : Theme.text-muted;
        }

        Text {
            text: root.text;
            color: root.active ? Theme.text-main : Theme.text-muted;
            font-size: Theme.font-body;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.badge-count >= 0 : VerticalLayout {
            alignment: center;

            Rectangle {
                min-width: 22px;
                height: 18px;
                border-radius: 9px;
                background: root.active ? Theme.primary : #ffffff14;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;

                    Text {
                        text: root.badge-count;
                        color: root.active ? Theme.on-primary : Theme.text-muted;
                        font-size: Theme.font-caption;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <int> active-tab: 0;
    in property <int> container-count: 0;
    in property <int> image-count: 0;
    in property <int> volume-count: 0;
    in property <int> network-count: 0;
    callback tab-selected(int);

    width: 220px;
    background: Theme.sidebar-background;

    // Right border line
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border-light;
    }

    VerticalLayout {
        padding: 12px;
        padding-top: 20px;
        spacing: 4px;

        // App logo / title
        HorizontalLayout {
            padding-left: 6px;
            padding-bottom: 20px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                Image {
                    width: 32px;
                    height: 32px;
                    source: @image-url("../../assets/rcdesktop.png");
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Text {
                    text: "RC Desktop";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-main;
                }

                Text {
                    text: "WSL Containers";
                    font-size: Theme.font-caption;
                    color: Theme.text-dim;
                }
            }
        }

        NavItem {
            text: "Dashboard";
            icon: Icons.home;
            active: root.active-tab == 0;
            clicked => { root.tab-selected(0); }
        }

        NavItem {
            text: "Containers";
            icon: Icons.package;
            active: root.active-tab == 1 || root.active-tab == 5;
            badge-count: root.container-count;
            clicked => { root.tab-selected(1); }
        }

        NavItem {
            text: "Images";
            icon: Icons.layers;
            active: root.active-tab == 2;
            badge-count: root.image-count;
            clicked => { root.tab-selected(2); }
        }

        NavItem {
            text: "Volumes";
            icon: Icons.drive;
            active: root.active-tab == 3;
            badge-count: root.volume-count;
            clicked => { root.tab-selected(3); }
        }

        NavItem {
            text: "Networks";
            icon: Icons.network;
            active: root.active-tab == 6;
            badge-count: root.network-count;
            clicked => { root.tab-selected(6); }
        }

        Rectangle { vertical-stretch: 1; }

        NavItem {
            text: "WSLC";
            icon: Icons.settings;
            active: root.active-tab == 7;
            clicked => { root.tab-selected(7); }
        }

        NavItem {
            text: "Diagnostics";
            icon: Icons.diagnostic;
            active: root.active-tab == 4;
            clicked => { root.tab-selected(4); }
        }
    }
}
