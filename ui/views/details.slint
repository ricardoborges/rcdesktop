import { Theme, Icons } from "../theme.slint";
import { IconButton } from "../components/button.slint";

export component DetailsModal inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> modal-title: "Details";
    in property <string> content-text: "";
    callback close();

    visible: root.is-open;
    background: #000000a0;

    // Click outside to close
    TouchArea {
        clicked => { root.close(); }
    }

    // Modal card
    Rectangle {
        width: min(760px, parent.width - 64px);
        height: min(560px, parent.height - 64px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 8px;
        clip: true;

        // Swallow clicks so they don't reach the backdrop
        TouchArea {}

        VerticalLayout {
            // Header
            HorizontalLayout {
                height: 52px;
                padding-left: 20px;
                padding-right: 10px;
                spacing: Theme.spacing-md;

                Text {
                    horizontal-stretch: 1;
                    text: root.modal-title;
                    font-size: Theme.font-subtitle;
                    font-weight: 600;
                    color: Theme.text-main;
                    vertical-alignment: center;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.close;
                        clicked => { root.close(); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // Scrollable content
            Rectangle {
                vertical-stretch: 1;
                background: #1c1c1c;
                border-bottom-left-radius: Theme.radius-lg;
                border-bottom-right-radius: Theme.radius-lg;

                Flickable {
                    content-height: max(self.height, content.preferred-height + 32px);

                    content := TextInput {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        text: root.content-text;
                        read-only: true;
                        color: #e4e4e4;
                        selection-background-color: Theme.primary;
                        selection-foreground-color: Theme.on-primary;
                        font-family: Theme.mono-font;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
