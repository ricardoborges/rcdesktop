import { Theme, Icons } from "../theme.slint";
import { ActionButton, Icon } from "../components/button.slint";
import { Card, PageHeader, Divider } from "../components/layout.slint";
import { SessionInfoItem } from "../models.slint";

component Tip inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> body;

    padding-top: 14px;
    padding-bottom: 14px;
    spacing: Theme.spacing-md;

    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Theme.radius-sm;
            background: #ffffff0a;

            Icon {
                text: root.icon;
                color: Theme.primary;
            }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: 4px;

        Text {
            text: root.title;
            font-size: Theme.font-body;
            font-weight: 600;
            color: Theme.text-main;
        }

        Text {
            text: root.body;
            font-size: Theme.font-body;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
}

export component DiagnosticsView inherits Rectangle {
    in property <SessionInfoItem> session;
    callback run-diagnostics();
    callback restart-wsl();

    background: Theme.background;

    VerticalLayout {
        padding: 28px;
        padding-top: Theme.spacing-lg;
        spacing: Theme.spacing-lg;

        PageHeader {
            title: "Diagnostics";
            subtitle: "Session health, lock resolution and troubleshooting";

            ActionButton {
                text: "Run diagnostics";
                icon: Icons.health;
                variant: "primary";
                clicked => { root.run-diagnostics(); }
            }

            ActionButton {
                text: "Reset WSL";
                icon: Icons.power;
                variant: "danger";
                clicked => { root.restart-wsl(); }
            }
        }

        Card {
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-xs;

                Text {
                    text: "Troubleshooting guide";
                    font-size: Theme.font-body-strong;
                    font-weight: 600;
                    color: Theme.text-main;
                    height: 28px;
                    vertical-alignment: center;
                }

                Tip {
                    icon: Icons.warning;
                    title: "Empty lists with ERROR_SHARING_VIOLATION (0x80070020)";
                    body: "Use Reset WSL (wsl --shutdown) to release session store file locks.";
                }
                Divider {}
                Tip {
                    icon: Icons.info;
                    title: "Single-lane command queue";
                    body: "Every wslc command is sequenced to avoid session store locks.";
                }
                Divider {}
                Tip {
                    icon: Icons.info;
                    title: "Session isolation";
                    body: "Sessions are split by elevation: match RC Desktop to your terminal.";
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
