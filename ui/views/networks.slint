import { Theme, Icons } from "../theme.slint";
import { ActionButton, IconButton, Icon } from "../components/button.slint";
import { Card, PageHeader, EmptyState, LoadingState, ColumnHeader, Divider, TableRow, TableHeader, TwoLineCell, TextCell } from "../components/layout.slint";
import { NetworkItem } from "../models.slint";

export component NetworksView inherits Rectangle {
    in property <[NetworkItem]> networks;
    // True until the first fetch completes; refreshing while a user refresh runs
    in property <bool> loading: false;
    in property <bool> refreshing: false;
    callback refresh-networks();
    callback remove-network(string);

    property <length> col-driver: 110px;
    property <length> col-scope: 90px;
    property <length> col-id: 120px;
    property <length> col-actions: Theme.control-height;

    background: Theme.background;

    VerticalLayout {
        padding: 28px;
        padding-top: Theme.spacing-lg;
        spacing: Theme.spacing-lg;

        PageHeader {
            title: "Networks";
            subtitle: "Container networks managed by WSLC";

            ActionButton {
                text: "Refresh";
                icon: Icons.refresh;
                busy: root.refreshing;
                clicked => { root.refresh-networks(); }
            }
        }

        if root.loading && root.networks.length == 0 : LoadingState {
            message: "Loading networks…";
        }

        if !root.loading && root.networks.length == 0 : EmptyState {
            icon: Icons.network;
            title: "No networks found";
            message: "Networks created by stacks or with wslc network create appear here.";
        }

        if root.networks.length > 0 : Card {
            vertical-stretch: 1;

            VerticalLayout {
                TableHeader {
                    ColumnHeader { text: "NAME"; horizontal-stretch: 1; min-width: 100px; }
                    ColumnHeader { text: "DRIVER"; width: root.col-driver; }
                    ColumnHeader { text: "SCOPE"; width: root.col-scope; }
                    ColumnHeader { text: "NETWORK ID"; width: root.col-id; }
                    ColumnHeader { text: "ACTIONS"; width: root.col-actions; horizontal-alignment: right; }
                }

                Divider {}

                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;

                        for net in root.networks : VerticalLayout {
                            TableRow {
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 100px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: net.stack != "" ? #60cdff1f : #ffffff0a;

                                            Icon {
                                                text: Icons.network;
                                                color: net.stack != "" ? Theme.primary : Theme.text-muted;
                                            }
                                        }
                                    }

                                    TwoLineCell {
                                        min-width: 0px;
                                        primary: net.name;
                                        secondary: net.builtin ? "Built-in network"
                                            : net.stack != "" ? "Stack  ·  " + net.stack
                                            : "User-defined";
                                    }
                                }

                                TextCell {
                                    width: root.col-driver;
                                    text: net.driver != "" ? net.driver : "—";
                                }

                                TextCell {
                                    width: root.col-scope;
                                    text: net.scope != "" ? net.scope : "—";
                                }

                                TextCell {
                                    width: root.col-id;
                                    text: net.id;
                                    font-family: Theme.mono-font;
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                }

                                VerticalLayout {
                                    width: root.col-actions;
                                    alignment: center;

                                    IconButton {
                                        icon: Icons.delete;
                                        tooltip: net.builtin ? "Built-in networks can't be removed" : "Delete network";
                                        accent: Theme.action-delete;
                                        busy: net.pending == "Removing…";
                                        enabled: !net.builtin && net.pending == "";
                                        clicked => { root.remove-network(net.name); }
                                    }
                                }
                            }

                            Divider {}
                        }
                    }
                }
            }
        }
    }
}
