import { Theme, Icons } from "../theme.slint";
import { ActionButton, Icon } from "../components/button.slint";

// Small Fluent-style dialog asking to confirm a destructive action.
export component ConfirmModal inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> modal-title;
    in property <string> message;
    in property <string> confirm-text: "Remove";
    callback confirm();
    callback cancel();

    visible: root.is-open;
    background: #000000a0;

    // Click outside to cancel
    TouchArea {
        clicked => { root.cancel(); }
    }

    Rectangle {
        width: min(440px, parent.width - 64px);
        height: card.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 8px;
        clip: true;

        // Swallow clicks so they don't reach the backdrop
        TouchArea {}

        card := VerticalLayout {
            HorizontalLayout {
                padding: 24px;
                spacing: Theme.spacing-md;

                VerticalLayout {
                    alignment: start;

                    Icon {
                        text: Icons.warning;
                        font-size: 20px;
                        color: Theme.status-danger;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing-sm;

                    Text {
                        text: root.modal-title;
                        font-size: Theme.font-subtitle;
                        font-weight: 600;
                        color: Theme.text-main;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.message;
                        font-size: Theme.font-body;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }

            // Footer
            Rectangle {
                background: #00000030;

                HorizontalLayout {
                    padding: Theme.spacing-md;
                    spacing: Theme.spacing-sm;
                    alignment: end;

                    ActionButton {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }

                    ActionButton {
                        text: root.confirm-text;
                        icon: Icons.delete;
                        variant: "danger";
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}
