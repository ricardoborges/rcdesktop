import { Theme, Icons } from "../theme.slint";
import { ActionButton, Icon } from "../components/button.slint";
import { Card, PageHeader, EmptyState, ColumnHeader, Divider, TableRow, TableHeader, TextCell } from "../components/layout.slint";
import { VolumeItem } from "../models.slint";

export component VolumesView inherits Rectangle {
    in property <[VolumeItem]> volumes;
    callback refresh-volumes();

    property <length> col-driver: 140px;
    property <length> col-scope: 140px;

    background: Theme.background;

    VerticalLayout {
        padding: 28px;
        padding-top: Theme.spacing-lg;
        spacing: Theme.spacing-lg;

        PageHeader {
            title: "Volumes";
            subtitle: "Persistent storage volumes configured in WSLC";

            ActionButton {
                text: "Refresh";
                icon: Icons.refresh;
                clicked => { root.refresh-volumes(); }
            }
        }

        if root.volumes.length == 0 : EmptyState {
            icon: Icons.drive;
            title: "No volumes detected";
            message: "Volumes created by containers will appear here.";
        }

        if root.volumes.length > 0 : Card {
            vertical-stretch: 1;

            VerticalLayout {
                TableHeader {
                    ColumnHeader { text: "NAME"; horizontal-stretch: 1; min-width: 100px; }
                    ColumnHeader { text: "DRIVER"; width: root.col-driver; }
                    ColumnHeader { text: "SCOPE"; width: root.col-scope; }
                }

                Divider {}

                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;

                        for vol in root.volumes : VerticalLayout {
                            TableRow {
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 100px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: #ffffff0a;

                                            Icon {
                                                text: Icons.drive;
                                                color: Theme.text-muted;
                                            }
                                        }
                                    }

                                    TextCell {
                                        horizontal-stretch: 1;
                                        text: vol.name;
                                        color: Theme.text-main;
                                        font-weight: 600;
                                    }
                                }

                                TextCell {
                                    width: root.col-driver;
                                    text: vol.driver;
                                }

                                TextCell {
                                    width: root.col-scope;
                                    text: vol.scope;
                                }
                            }

                            Divider {}
                        }
                    }
                }
            }
        }
    }
}
