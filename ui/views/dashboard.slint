import { Theme } from "../theme.slint";
import { ActionButton } from "../components/button.slint";
import { SessionInfoItem } from "../models.slint";

export component DashboardView inherits Rectangle {
    in property <SessionInfoItem> session;
    in property <int> running-containers: 0;
    in property <int> total-containers: 0;
    in property <int> total-images: 0;
    in property <int> total-volumes: 0;
    callback restart-wsl();
    callback refresh-all();

    background: Theme.background;

    VerticalLayout {
        padding: Theme.spacing-lg;
        spacing: Theme.spacing-lg;

        // Top bar
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: Theme.spacing-xs;
                Text {
                    text: "System Overview";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text-main;
                }
                Text {
                    text: "Windows 11 WSL Container Runtime";
                    font-size: 13px;
                    color: Theme.text-muted;
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing-sm;
                ActionButton {
                    text: "Refresh";
                    icon: "🔄";
                    clicked => { root.refresh-all(); }
                }
                ActionButton {
                    text: "Restart WSL";
                    icon: "⚡";
                    variant: "danger";
                    clicked => { root.restart-wsl(); }
                }
            }
        }

        // Stats Cards Grid
        HorizontalLayout {
            spacing: Theme.spacing-md;
            height: 110px;

            // Running Containers Card
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-light;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    alignment: space-between;

                    Text {
                        text: "Active Containers";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-xs;
                        Text {
                            text: root.running-containers;
                            font-size: 28px;
                            font-weight: 700;
                            color: Theme.status-running;
                        }
                        Text {
                            text: " / " + root.total-containers + " total";
                            font-size: 13px;
                            color: Theme.text-dim;
                            vertical-alignment: bottom;
                        }
                    }
                }
            }

            // Total Images Card
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-light;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    alignment: space-between;

                    Text {
                        text: "Stored Images";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }

                    Text {
                        text: root.total-images;
                        font-size: 28px;
                        font-weight: 700;
                        color: Theme.primary;
                    }
                }
            }

            // Volumes Card
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-light;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: Theme.spacing-md;
                    alignment: space-between;

                    Text {
                        text: "Persistent Volumes";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }

                    Text {
                        text: root.total-volumes;
                        font-size: 28px;
                        font-weight: 700;
                        color: Theme.text-main;
                    }
                }
            }
        }

        // Environment Details Card
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-light;

            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;

                Text {
                    text: "WSLC Runtime Environment";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-main;
                }

                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    Text {
                        text: "Binary Version: " + root.session.version;
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: "Session Name: " + root.session.session_id;
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: "Elevation: " + (root.session.is_elevated ? "Elevated (Admin)" : "Standard User");
                        font-size: 12px;
                        color: root.session.is_elevated ? Theme.status-starting : Theme.status-running;
                    }
                }

                Text {
                    text: "Health Status: " + root.session.status_message;
                    font-size: 12px;
                    color: root.session.is_healthy ? Theme.status-running : Theme.status-danger;
                }
            }
        }

        Rectangle { /* vertical spacer */ }
    }
}
