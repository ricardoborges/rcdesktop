import { Theme, Icons } from "../theme.slint";
import { ActionButton, Icon } from "../components/button.slint";
import { Card, PageHeader, Divider } from "../components/layout.slint";
import { SessionInfoItem } from "../models.slint";

component StatCard inherits Card {
    in property <string> label;
    in property <string> icon;
    in property <int> value;
    in property <string> suffix: "";
    in property <color> accent: Theme.text-main;

    horizontal-stretch: 1;
    height: 116px;

    VerticalLayout {
        padding: 20px;
        spacing: Theme.spacing-sm;

        HorizontalLayout {
            spacing: Theme.spacing-sm;

            Text {
                text: root.label;
                font-size: Theme.font-body;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: #ffffff0a;

                Icon {
                    text: root.icon;
                    color: root.accent;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: start;
            spacing: 6px;

            Text {
                text: root.value;
                font-size: Theme.font-display;
                font-weight: 600;
                color: root.accent;
                vertical-alignment: bottom;
            }

            if root.suffix != "" : VerticalLayout {
                alignment: end;
                padding-bottom: 6px;

                Text {
                    text: root.suffix;
                    font-size: Theme.font-body;
                    color: Theme.text-dim;
                }
            }
        }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text-main;

    height: 44px;
    spacing: Theme.spacing-md;

    Text {
        width: 160px;
        text: root.label;
        font-size: Theme.font-body;
        color: Theme.text-dim;
        vertical-alignment: center;
    }

    Text {
        horizontal-stretch: 1;
        text: root.value;
        font-size: Theme.font-body;
        color: root.value-color;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component DashboardView inherits Rectangle {
    in property <SessionInfoItem> session;
    in property <int> running-containers: 0;
    in property <int> total-containers: 0;
    in property <int> total-images: 0;
    in property <int> total-volumes: 0;
    callback restart-wsl();
    callback refresh-all();

    background: Theme.background;

    VerticalLayout {
        padding: 28px;
        padding-top: Theme.spacing-lg;
        spacing: Theme.spacing-lg;

        PageHeader {
            title: "Overview";
            subtitle: "Windows 11 WSL container runtime";

            ActionButton {
                text: "Refresh";
                icon: Icons.refresh;
                clicked => { root.refresh-all(); }
            }

            ActionButton {
                text: "Restart WSL";
                icon: Icons.power;
                variant: "danger";
                clicked => { root.restart-wsl(); }
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing-md;

            StatCard {
                label: "Running containers";
                icon: Icons.package;
                value: root.running-containers;
                suffix: "of " + root.total-containers;
                accent: Theme.status-running;
            }

            StatCard {
                label: "Images";
                icon: Icons.layers;
                value: root.total-images;
                accent: Theme.primary;
            }

            StatCard {
                label: "Volumes";
                icon: Icons.drive;
                value: root.total-volumes;
            }
        }

        Card {
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-sm;

                Text {
                    text: "Runtime environment";
                    font-size: Theme.font-body-strong;
                    font-weight: 600;
                    color: Theme.text-main;
                    height: 28px;
                    vertical-alignment: center;
                }

                InfoRow {
                    label: "Health";
                    value: root.session.status_message;
                    value-color: root.session.is_healthy ? Theme.status-running : Theme.status-danger;
                }
                Divider {}
                InfoRow {
                    label: "Session";
                    value: root.session.session_id;
                }
                Divider {}
                InfoRow {
                    label: "wslc version";
                    value: root.session.version;
                }
                Divider {}
                InfoRow {
                    label: "Elevation";
                    value: root.session.is_elevated ? "Administrator (elevated)" : "Standard user";
                    value-color: root.session.is_elevated ? Theme.status-starting : Theme.text-main;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
