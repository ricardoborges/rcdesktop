import { Theme, Icons } from "../theme.slint";
import { ActionButton, IconButton, Icon } from "../components/button.slint";
import { Card, PageHeader, EmptyState, LoadingState, ColumnHeader, Divider, TableRow, TableHeader, TwoLineCell, TextCell } from "../components/layout.slint";
import { ImageItem } from "../models.slint";

export component ImagesView inherits Rectangle {
    in property <[ImageItem]> images;
    // True until the first fetch completes; refreshing while a user refresh runs
    in property <bool> loading: false;
    in property <bool> refreshing: false;
    callback pull-image(string);
    callback remove-image(string);
    callback refresh-images();
    callback run-image(string);

    property <length> col-id: 120px;
    property <length> col-size: 90px;
    property <length> col-created: 110px;
    property <length> col-actions: 2 * Theme.control-height + 2px;

    background: Theme.background;

    VerticalLayout {
        padding: 28px;
        padding-top: Theme.spacing-lg;
        spacing: Theme.spacing-lg;

        PageHeader {
            title: "Images";
            subtitle: "Local OCI container images in WSLC";

            ActionButton {
                text: "Refresh";
                icon: Icons.refresh;
                busy: root.refreshing;
                clicked => { root.refresh-images(); }
            }
        }

        // Pull bar
        HorizontalLayout {
            spacing: Theme.spacing-sm;

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-height;
                border-radius: Theme.radius-sm;
                background: pull-input.has-focus ? #1f1f1f : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                // Fluent focus underline
                Rectangle {
                    y: parent.height - self.height;
                    height: pull-input.has-focus ? 2px : 1px;
                    background: pull-input.has-focus ? Theme.primary : #ffffff40;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: Theme.spacing-sm;

                    Icon {
                        text: Icons.download;
                        font-size: 12px;
                        color: Theme.text-dim;
                    }

                    Rectangle {
                        horizontal-stretch: 1;

                        pull-input := TextInput {
                            width: 100%;
                            height: 100%;
                            text: "nginx:alpine";
                            color: Theme.text-main;
                            selection-background-color: Theme.primary;
                            selection-foreground-color: Theme.on-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            accepted => {
                                if self.text != "" {
                                    root.pull-image(self.text);
                                }
                            }
                        }

                        if pull-input.text == "" : Text {
                            text: "image:tag  (e.g. nginx:alpine)";
                            color: Theme.text-dim;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            x: 0px;
                        }
                    }
                }
            }

            ActionButton {
                text: "Pull image";
                icon: Icons.download;
                variant: "primary";
                enabled: pull-input.text != "";
                clicked => { root.pull-image(pull-input.text); }
            }
        }

        if root.loading && root.images.length == 0 : LoadingState {
            message: "Loading images…";
        }

        if !root.loading && root.images.length == 0 : EmptyState {
            icon: Icons.layers;
            title: "No images available";
            message: "Use the pull field above to fetch container images.";
        }

        if root.images.length > 0 : Card {
            vertical-stretch: 1;

            VerticalLayout {
                TableHeader {
                    ColumnHeader { text: "REPOSITORY : TAG"; horizontal-stretch: 1; min-width: 100px; }
                    ColumnHeader { text: "IMAGE ID"; width: root.col-id; }
                    ColumnHeader { text: "SIZE"; width: root.col-size; horizontal-alignment: right; }
                    ColumnHeader { text: "CREATED"; width: root.col-created; }
                    Rectangle { width: root.col-actions; }
                }

                Divider {}

                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;

                        for img in root.images : VerticalLayout {
                            TableRow {
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 100px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: #ffffff0a;

                                            Icon {
                                                text: Icons.layers;
                                                color: Theme.primary;
                                            }
                                        }
                                    }

                                    TwoLineCell {
                                        primary: img.repository;
                                        secondary: img.tag;
                                    }
                                }

                                TextCell {
                                    width: root.col-id;
                                    text: img.id;
                                    font-family: Theme.mono-font;
                                    font-size: 12px;
                                }

                                TextCell {
                                    width: root.col-size;
                                    text: img.size;
                                    horizontal-alignment: right;
                                }

                                TextCell {
                                    width: root.col-created;
                                    text: img.created;
                                    color: Theme.text-dim;
                                }

                                VerticalLayout {
                                    width: root.col-actions;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 2px;

                                        IconButton {
                                            icon: Icons.play;
                                            tooltip: "Run container";
                                            accent: Theme.action-start;
                                            enabled: img.pending == "";
                                            clicked => { root.run-image(img.tag == "" || img.tag == "<none>" ? img.repository : img.repository + ":" + img.tag); }
                                        }

                                        IconButton {
                                            icon: Icons.delete;
                                            tooltip: "Delete image";
                                            accent: Theme.action-delete;
                                            busy: img.pending == "Removing…";
                                            enabled: img.pending == "";
                                            clicked => { root.remove-image(img.id); }
                                        }
                                    }
                                }
                            }

                            Divider {}
                        }
                    }
                }
            }
        }
    }
}
