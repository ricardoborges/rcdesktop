export global Theme {
    // Windows 11 Dark (Mica-like) palette
    out property <color> background: #202020;
    out property <color> sidebar-background: #1b1b1b;
    out property <color> surface: #2d2d2d;
    out property <color> surface-hover: #383838;
    out property <color> surface-active: #333333;
    out property <color> card: #2a2a2a;
    out property <color> row-hover: #323232;
    out property <color> border: #3d3d3d;
    out property <color> border-light: #333333;
    out property <color> divider: #ffffff10;

    // Accents (Windows 11 default dark accent)
    out property <color> primary: #60cdff;
    out property <color> primary-hover: #5ab9e6;
    out property <color> primary-pressed: #4fa3cc;
    out property <color> on-primary: #000000;

    // Text colors
    out property <color> text-main: #ffffff;
    out property <color> text-muted: #c8c8c8;
    out property <color> text-dim: #8b8b8b;

    // Status colors
    out property <color> status-running: #6ccb5f;
    out property <color> status-running-bg: #6ccb5f1f;
    out property <color> status-exited: #9a9a9a;
    out property <color> status-exited-bg: #ffffff0f;
    out property <color> status-starting: #fce100;
    out property <color> status-starting-bg: #fce1001f;
    out property <color> status-danger: #ff99a4;
    out property <color> status-danger-bg: #ff99a41a;
    out property <color> danger-solid: #c42b1c;

    // Lifecycle action colors
    out property <color> action-start: #6ccb5f;
    out property <color> action-stop: #ffa94d;
    out property <color> action-restart: #60cdff;
    out property <color> action-delete: #ff6b6b;

    // Typography
    out property <string> icon-font: "Segoe Fluent Icons";
    out property <string> mono-font: "Cascadia Mono";
    out property <length> font-caption: 11px;
    out property <length> font-body: 13px;
    out property <length> font-body-strong: 14px;
    out property <length> font-subtitle: 16px;
    out property <length> font-title: 24px;
    out property <length> font-display: 32px;

    // Layout
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> control-height: 32px;
    out property <length> row-height: 56px;
}

// Segoe Fluent Icons code points
