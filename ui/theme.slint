    out property <string> stop: "\u{E71A}";
    out property <string> restart: "\u{E777}";
    out property <string> terminal: "\u{E756}";
    out property <string> document: "\u{E8A5}";
    out property <string> code: "\u{E943}";
    out property <string> delete: "\u{E74D}";
    out property <string> download: "\u{E896}";
    out property <string> power: "\u{E7E8}";
    out property <string> globe: "\u{E774}";
    out property <string> warning: "\u{E7BA}";
    out property <string> close: "\u{E8BB}";
    out property <string> health: "\u{E95E}";
