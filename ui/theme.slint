export global Theme {
    // Windows 11 Dark Mode Palette
    out property <color> background: #1c1c1f;
    out property <color> sidebar-background: #18181b;
    out property <color> surface: #27272a;
    out property <color> surface-hover: #3f3f46;
    out property <color> surface-active: #52525b;
    out property <color> card: #202023;
    out property <color> border: #3f3f46;
    out property <color> border-light: #27272a;

    // Accents
    out property <color> primary: #38bdf8;
    out property <color> primary-hover: #0284c7;
    out property <color> primary-text: #0369a1;

    // Text colors
    out property <color> text-main: #f4f4f5;
    out property <color> text-muted: #a1a1aa;
    out property <color> text-dim: #71717a;

    // Status colors
    out property <color> status-running: #22c55e;
    out property <color> status-running-bg: #14532d;
    out property <color> status-exited: #71717a;
    out property <color> status-exited-bg: #27272a;
    out property <color> status-starting: #eab308;
    out property <color> status-starting-bg: #713f12;
    out property <color> status-danger: #ef4444;
    out property <color> status-danger-bg: #7f1d1d;

    // Layout
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
}
